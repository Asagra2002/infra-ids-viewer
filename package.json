{
  "name": "infra-ids-viewer",
  "version": "1.1.0",
  "description": "IDS checker and BCF viewer with GIS for BIM infrastructure",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev": "vite",
    "postinstall": "mkdir -p public/fragments-worker && cp node_modules/@thatopen/fragments/dist/Worker/worker.mjs public/fragments-worker/ 2>/dev/null || true",
    "prebuild": "mkdir -p public/assets/IFC\\ example/ public/fragments-worker && cp -r public/assets/IFC\\ example/*.ifc public/assets/IFC\\ example/ 2>/dev/null || true && cp node_modules/@thatopen/fragments/dist/Worker/worker.mjs public/fragments-worker/",
    "build": "npm run prebuild && vite build",
    "serve": "vite preview",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --config jest.config.mjs",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --config jest.config.mjs --watch"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/jest": "29.5.12",
    "@types/leaflet": "^1.9.20",
    "@types/react": "18.2.31",
    "@types/react-dom": "18.2.14",
    "@types/three": "0.175.0",
    "@types/uuid": "9.0.8",
    "@vitejs/plugin-react": "4.0.3",
    "baseline-browser-mapping": "^2.9.19",
    "http-proxy-middleware": "^3.0.5",
    "jest": "29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "terser": "^5.39.0",
    "ts-jest": "29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.2",
    "vite": "^5.2.0",
    "vite-plugin-static-copy": "^3.1.1"
  },
  "dependencies": {
    "@cesium/engine": "^22.3.0",
    "@dtcv/citygml": "^1.2.1",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/material": "^7.0.2",
    "@thatopen/components": "3.1.3",
    "@thatopen/components-front": "3.1.3",
    "@thatopen/fragments": "3.1.3",
    "@thatopen/ui": "3.1.3",
    "@thatopen/ui-obc": "3.1.3",
    "@turf/turf": "^7.2.0",
    "@types/maplibre-gl": "^1.14.0",
    "@types/ol": "^7.0.0",
    "@types/proj4": "^2.5.6",
    "3d-tiles-renderer": "^0.4.21",
    "cesium": "^1.138.0",
    "chart.js": "4.4.7",
    "chartjs-plugin-datalabels": "2.2.0",
    "firebase": "10.5.2",
    "html2canvas": "1.4.1",
    "jspdf": "2.5.2",
    "jszip": "^3.10.1",
    "leaflet": "^1.9.4",
    "maplibre-gl": "^5.1.0",
    "ol": "^10.6.1",
    "openbim-components": "1.1.5",
    "react": "18.2.0",
    "react-chartjs-2": "5.3.0",
    "react-dom": "18.2.0",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "6.18.0",
    "react-toastify": "^11.0.5",
    "three": "0.175.0",
    "uuid": "9.0.1",
    "web-ifc": "^0.0.71",
    "xlsx": "^0.18.5",
    "zustand": "5.0.3"
  },
  "private": true,
