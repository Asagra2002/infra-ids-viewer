          </ids:baseName>
        </ids:property>
      </ids:requirements>
    </ids:specification>
    <ids:specification ifcVersion="IFC4X3_ADD2" name="Rakennuspaikan kaavatilanne" description="Rakennushankkeelle rekisteröitävä tieto rakennuksen sijoittumisesta kaava-alueelle tai sen ulkopuolelle rakentamisluvan hakuhetkellä.&#10;Koodisto: Kaavatilanne">
      <ids:applicability minOccurs="1" maxOccurs="unbounded">
        <ids:entity>
          <ids:name>
            <ids:simpleValue>IFCSITE</ids:simpleValue>
          </ids:name>
        </ids:entity>
      </ids:applicability>
      <ids:requirements>
        <ids:property dataType="IFCLABEL" cardinality="required">
          <ids:propertySet>
            <ids:simpleValue>FI_Kiinteistö</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>Kaavatilanne</ids:simpleValue>
          </ids:baseName>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:enumeration value="Asemakaava" />
              <xs:enumeration value="Rakennuskaava" />
              <xs:enumeration value="Rantakaava" />
              <xs:enumeration value="Yleiskaava" />
              <xs:enumeration value="Ei kaavaa" />
              <xs:enumeration value="Maakuntakaava" />
              <xs:enumeration value="Oikeusvaikutteinen yleiskaava" />
              <xs:enumeration value="Oikeusvaikutukseton yleiskaava" />
              <xs:enumeration value="Ranta-asemakaava" />
              <xs:enumeration value="Stadsplan" />
              <xs:enumeration value="Byggnadsplan" />
              <xs:enumeration value="Strandplan" />
              <xs:enumeration value="Generalplan" />
              <xs:enumeration value="Ingen plan" />
              <xs:enumeration value="Landskapsplan" />
              <xs:enumeration value="Generalplan med rättsverkningar" />
              <xs:enumeration value="Generalplan utan rättsverkningar" />
              <xs:enumeration value="Stranddetaljplan" />
            </xs:restriction>
          </ids:value>
        </ids:property>
      </ids:requirements>
    </ids:specification>
    <ids:specification ifcVersion="IFC4X3_ADD2" name="Rakennuspaikan hallinta- tai omistusmuoto" description="Rakennuspaikan omistus- tai hallintasuhde. Tieto ei sisälly asetuksen mukaisiin ydintietoihin, mutta rakennusvalvonnan tulee toimittaa se DVV:lle.&#10;Koodisto: Rakennuspaikan hallintaperuste">
      <ids:applicability minOccurs="1" maxOccurs="unbounded">
        <ids:entity>
          <ids:name>
            <ids:simpleValue>IFCSITE</ids:simpleValue>
          </ids:name>
        </ids:entity>
      </ids:applicability>
      <ids:requirements>
        <ids:property dataType="IFCLABEL" cardinality="optional">
          <ids:propertySet>
            <ids:simpleValue>FI_Kiinteistö</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>Hallintaperuste</ids:simpleValue>
          </ids:baseName>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:enumeration value="Oma" />
              <xs:enumeration value="Vuokrattu" />
              <xs:enumeration value="Muu oikeus" />
              <xs:enumeration value="Egen" />
              <xs:enumeration value="Arrenderad" />
              <xs:enumeration value="Annan rättighet" />
            </xs:restriction>
          </ids:value>
        </ids:property>
      </ids:requirements>
    </ids:specification>
    <ids:specification ifcVersion="IFC4X3_ADD2" name="Rakentamistoimenpiteen laji" description="Tieto minkä tyyppisestä rakentamistoimenpiteestä on kyse.&#10;Koodisto: Rakentamistoimenpide">
      <ids:applicability minOccurs="1" maxOccurs="unbounded">
        <ids:entity>
          <ids:name>
            <ids:simpleValue>IFCBUILDING</ids:simpleValue>
          </ids:name>
        </ids:entity>
      </ids:applicability>
      <ids:requirements>
        <ids:property dataType="IFCLABEL" cardinality="required">
          <ids:propertySet>
            <ids:simpleValue>FI_Kohde</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>Rakentamistoimenpide</ids:simpleValue>
          </ids:baseName>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:enumeration value="Uusi rakennus tai rakennelma" />
              <xs:enumeration value="Laajentaminen" />
              <xs:enumeration value="Uudelleen rakentamiseen verrattava muutostyö" />
              <xs:enumeration value="Muu muutostyö" />
              <xs:enumeration value="Purkaminen" />
              <xs:enumeration value="Rakennuksen osittainen purkaminen" />
              <xs:enumeration value="Kaupunkikuvatoimenpide" />
              <xs:enumeration value="Maisemaa muuttava toimenpide" />
              <xs:enumeration value="Rakennuksen tai rakennelman päivitys" />
              <xs:enumeration value="Ny byggnad eller konstruktion" />
              <xs:enumeration value="Utvidgning" />
              <xs:enumeration value="Ändringsarbete som är jämförbar med nybyggande" />
              <xs:enumeration value="Annat ändringsarbete" />
              <xs:enumeration value="Rivning" />
              <xs:enumeration value="Delvis rivning av en byggnad" />
              <xs:enumeration value="Stadbildsåtgärd" />
              <xs:enumeration value="Åtgärd som ändrar landskapet" />
              <xs:enumeration value="Uppdatering av byggnad eller konstruktion" />
              <xs:enumeration value="New building or structure" />
              <xs:enumeration value="Expansion" />
              <xs:enumeration value="Alteration work comparable to rebuilding" />
              <xs:enumeration value="Other alteration work" />
              <xs:enumeration value="Demolition" />
              <xs:enumeration value="Partial demolition of building" />
              <xs:enumeration value="Cityscape action" />
              <xs:enumeration value="Landscape-altering action" />
              <xs:enumeration value="Update of building or structure" />
            </xs:restriction>
          </ids:value>
        </ids:property>
      </ids:requirements>
    </ids:specification>
    <ids:specification ifcVersion="IFC4X3_ADD2" name="Rakennustoimenpide on perusparannus" description="Mikäli kyseessä on rakennuksen perusparannustoimenpide, arvo on TRUE. Mikäli rakennustoimenpide on uudisrakentaminen, arvo on FALSE.">
      <ids:applicability minOccurs="1" maxOccurs="unbounded">
        <ids:entity>
          <ids:name>
            <ids:simpleValue>IFCBUILDING</ids:simpleValue>
          </ids:name>
        </ids:entity>
      </ids:applicability>
      <ids:requirements>
        <ids:property dataType="IFCBOOLEAN" cardinality="required">
          <ids:propertySet>
            <ids:simpleValue>FI_Kohde</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>Perusparannus</ids:simpleValue>
          </ids:baseName>
        </ids:property>
      </ids:requirements>
    </ids:specification>
    <ids:specification ifcVersion="IFC4X3_ADD2" name="Muutosala" description="Pinta-alatieto (m2) rakennuskohteen alueesta, johon haettavan luvan mukainen muutos kohdistuu.">
      <ids:applicability minOccurs="1" maxOccurs="unbounded">
        <ids:entity>
          <ids:name>
            <ids:simpleValue>IFCBUILDING</ids:simpleValue>
          </ids:name>
        </ids:entity>
      </ids:applicability>
      <ids:requirements>
        <ids:property dataType="IFCINTEGER" cardinality="optional">
          <ids:propertySet>
            <ids:simpleValue>FI_Kohde</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>Muutosala</ids:simpleValue>
          </ids:baseName>
        </ids:property>
      </ids:requirements>
    </ids:specification>
    <ids:specification ifcVersion="IFC4X3_ADD2" name="Liiketaloudellinen rakentaminen (työ teetetään ulkopuolisella)" description="Liiketaloudellisella rakentamisella tarkoitetaan, että suurin osa rakentamistyöstä teetetään ulkopuolisella rakentajalla (TRUE). Mikäli suurin osa rakentamistyöstä tehdään omatoimisesti, kyse ei ole liiketoimisesta rakentamisesta (FALSE).">
      <ids:applicability minOccurs="1" maxOccurs="unbounded">
        <ids:entity>
          <ids:name>
            <ids:simpleValue>IFCBUILDING</ids:simpleValue>
          </ids:name>
        </ids:entity>
      </ids:applicability>
      <ids:requirements>
        <ids:property dataType="IFCBOOLEAN" cardinality="required">
          <ids:propertySet>
            <ids:simpleValue>FI_Kohde</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>LiiketaloudellinenRakentaminen</ids:simpleValue>
          </ids:baseName>
        </ids:property>
      </ids:requirements>
    </ids:specification>
    <ids:specification ifcVersion="IFC4X3_ADD2" name="Rakennuskohteen nimi" description="Rakennuskohteen nimi. Rakennuskohteen nimi voi olla eri kuin rakennuspaikan nimi.">
