          </ids:baseName>
        </ids:property>
      </ids:requirements>
    </ids:specification>
    <ids:specification ifcVersion="IFC4X3_ADD2" name="Rakennuspaikan kiinteistötunnus" description="Kiinteistörekisteriin merkityn rekisteriyksikön yksilöivä tunnus.">
