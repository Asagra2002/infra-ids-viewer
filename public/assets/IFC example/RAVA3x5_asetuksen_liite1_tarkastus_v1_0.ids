          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>VastaavaSuunnittelija</ids:simpleValue>
          </ids:baseName>
        </ids:property>
      </ids:requirements>
    </ids:specification>
    <ids:specification ifcVersion="IFC4X3_ADD2" name="Rakennussuunnittelutoimiston nimi" description="Rakennussuunnittelutoimiston nimi.">
      <ids:applicability minOccurs="1" maxOccurs="unbounded">
        <ids:entity>
          <ids:name>
