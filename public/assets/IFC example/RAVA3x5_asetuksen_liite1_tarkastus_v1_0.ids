          </ids:baseName>
        </ids:property>
      </ids:requirements>
    </ids:specification>
    <ids:specification ifcVersion="IFC4X3_ADD2" name="Huoneistoalan muutos" description="Tieto kohteen huoneistoalan muutoksesta rakentamistoimenpiteellä. Muutos voi olla positiivinen tai negatiivinen. Yksikkö m2.">
