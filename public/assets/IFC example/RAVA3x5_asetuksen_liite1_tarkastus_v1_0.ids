              <xs:enumeration value="Olennaisesti kokonaan pinnan alla" />
              <xs:enumeration value="Kokonaan pinnan alla" />
              <xs:enumeration value="Helt ovanför jordytan" />
              <xs:enumeration value="Väsentligen helt ovanför jordytan" />
              <xs:enumeration value="Ovanför och under jordytan" />
              <xs:enumeration value="Väsentligen helt under jordytan" />
              <xs:enumeration value="Helt under jordytan" />
