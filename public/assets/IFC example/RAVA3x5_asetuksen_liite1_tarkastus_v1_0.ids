          </ids:baseName>
        </ids:property>
      </ids:requirements>
    </ids:specification>
    <ids:specification ifcVersion="IFC4X3_ADD2" name="Rakennuspaikan nimi" description="Rakennuspaikan nimi. Rakennuspaikalla ja rakennuskohteella voi olla sama nimi.">
      <ids:applicability minOccurs="1" maxOccurs="unbounded">
        <ids:entity>
