    </ids:specification>
    <ids:specification ifcVersion="IFC4X3_ADD2" name="Kerrosluku" description="Rakennuksen maanpäällisten kerrosten lukumäärä. Kerroslukuun lasketaan kaikki kokonaan tai pääasiallisesti maanpinnan yläpuolella olevat kerrokset, joissa on asuin- tai työ (toimi-) tiloja tai rakennuksen pääasiallisen käyttötarkoituksen mukaisia tiloja. Kerroslukuun ei lasketa kellaria ja ullakkoa.">
      <ids:applicability minOccurs="1" maxOccurs="unbounded">
