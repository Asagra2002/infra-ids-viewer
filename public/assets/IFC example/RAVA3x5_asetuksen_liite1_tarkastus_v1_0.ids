    <ids:specification ifcVersion="IFC4X3_ADD2" name="Kokonaisalan muutos" description="Tieto kohteen kokonaisalan muutoksesta rakentamistoimenpiteellä käsittäen kerrosten, kellareiden ja lämpöeristettyjen ullakoiden pinta-alat ulkomitoin. Kokonaisalaan ei lasketa parvekkeita, katoksia eikä 160 cm:ä matalampia tiloja. Muutos voi olla positiivinen tai negatiivinen. Yksikkö m2.">
      <ids:applicability minOccurs="1" maxOccurs="unbounded">
        <ids:entity>
          <ids:name>
            <ids:simpleValue>IFCBUILDING</ids:simpleValue>
          </ids:name>
        </ids:entity>
      </ids:applicability>
      <ids:requirements>
        <ids:property dataType="IFCINTEGER" cardinality="optional">
          <ids:propertySet>
            <ids:simpleValue>FI_Kohde</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>KokonaisalanMuutos</ids:simpleValue>
          </ids:baseName>
        </ids:property>
      </ids:requirements>
    </ids:specification>
    <ids:specification ifcVersion="IFC4X3_ADD2" name="Kerrosalan muutos" description="Tieto kohteen kerrosalan muutoksesta rakentamistoimenpiteellä käsittäen kerrosten alat ulkoseinien ulkopinnan mukaan laskettuina sekä sen kellarikerroksen tai ullakon alan, johon sijoitetaan tai voidaan sijoittaa rakennuksen pääasiallisen käyttötarkoituksen mukaisia tiloja. Muutos voi olla positiivinen tai negatiivinen Yksikkö m2.">
      <ids:applicability minOccurs="1" maxOccurs="unbounded">
        <ids:entity>
          <ids:name>
            <ids:simpleValue>IFCBUILDING</ids:simpleValue>
          </ids:name>
        </ids:entity>
      </ids:applicability>
      <ids:requirements>
        <ids:property dataType="IFCINTEGER" cardinality="optional">
          <ids:propertySet>
            <ids:simpleValue>FI_Kohde</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>KerrosalanMuutos</ids:simpleValue>
          </ids:baseName>
        </ids:property>
      </ids:requirements>
    </ids:specification>
    <ids:specification ifcVersion="IFC4X3_ADD2" name="Rakennusoikeudellisen kerrosalan muutos" description="Tieto kohteen rakennusoikeudellisen kerrosalan muutoksesta (kerrosala rakentamislain 751/2023 9§ sallimin poikkeamin) rakentamistoimenpiteellä. Muutos voi olla positiivinen tai negatiivinen. Yksikkö m2.">
      <ids:applicability minOccurs="1" maxOccurs="unbounded">
        <ids:entity>
