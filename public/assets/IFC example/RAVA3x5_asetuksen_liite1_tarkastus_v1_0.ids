    <ids:specification ifcVersion="IFC4X3_ADD2" name="Tietomallin korkeuskoordinaattijärjestelmä" description="Yksi arvo koodistosta sisältäen vain koodin nimen sellaisena kuin se on koodistossa. Arvoksi hyväksytään kaikki ko. koodistossa olevat koodien nimien kieliversiot. Esimerkiksi &quot;N2000&quot;.">
      <ids:applicability minOccurs="1" maxOccurs="unbounded">
        <ids:entity>
          <ids:name>
            <ids:simpleValue>IFCSITE</ids:simpleValue>
          </ids:name>
        </ids:entity>
      </ids:applicability>
      <ids:requirements>
        <ids:entity>
          <ids:name>
            <ids:simpleValue>IFCSITE</ids:simpleValue>
          </ids:name>
        </ids:entity>
        <ids:property dataType="IFCLABEL" cardinality="required">
          <ids:propertySet>
            <ids:simpleValue>FI_Kiinteistö</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>Korkojärjestelmä</ids:simpleValue>
